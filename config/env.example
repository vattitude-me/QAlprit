# Optional: Jira / Confluence references (`references:` on a journey or workflow).
# The Workbench writes these for you under Settings & setup > Jira & Confluence.
# ATLASSIAN_BASE_URL=https://your-site.atlassian.net
# ATLASSIAN_EMAIL=you@example.com        # leave out for a personal access token (PAT)
# ATLASSIAN_API_TOKEN=your-atlassian-api-token
# JIRA_BASE_URL= / CONFLUENCE_BASE_URL=  # only when Jira and Confluence live on different hosts
# Separate credentials per product. A product with its own token uses its own email
# (leave it out for a PAT); a product without one uses the ATLASSIAN_* pair above.
# JIRA_EMAIL= / JIRA_API_TOKEN=
# CONFLUENCE_EMAIL= / CONFLUENCE_API_TOKEN=

# Optional: AI screenshot check (qalprit run --ai-review, qalprit review, "Check with AI").
# Who does the check: anthropic (default), agy (Antigravity CLI) or copilot (GitHub Copilot CLI).
# QALPRIT_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key   # only for the anthropic provider
# agy and copilot use their own sign-in. Set these only if the CLI is not on your PATH or you want a model.
# QALPRIT_AGY_BIN= / QALPRIT_COPILOT_BIN=
# QALPRIT_AGY_MODEL= / QALPRIT_COPILOT_MODEL=

# Optional: TNG onboarding journey (specs/tng/TNG-002.md). Codes are sent here and typed in the Workbench.
TNG_PHONE=4165550100
TNG_EMAIL=you@example.com
